+def cmd_serve(args):
+    """
+    Serves the Neovim WASM Studio + Skill-Tree DAG + Autolab Scoreboard (`docs/`) locally
+    and exposes `/api/judge` for sub-100ms local `g++ -O3 -std=c++20` execution.
